# =============================================================================
# Secrets and environment files — NEVER commit these
# =============================================================================
.env
.env.*
!.env.example
*.env
!*.env.example
backend/.env
frontend/.env
.secrets
secrets/
*.pem
*.key
*.pfx
*.p12
id_rsa
id_rsa.*
credentials.json
service-account*.json
*.kdbx

# =============================================================================
# Python / backend
# =============================================================================
backend/.venv/
.venv/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# =============================================================================
# Node / frontend
# =============================================================================
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
*.tsbuildinfo

# =============================================================================
# Machine-learning artifacts
# =============================================================================
# NOTE: the runtime classifier artifact IS intentionally committed:
#   backend/app/classification/artifacts/classifier_v1.joblib
# The API loads it at startup, it is small (a few hundred KB), and shipping it
# keeps the service runnable without a training step. Do not ignore that path.
#
# Regenerable/heavy training outputs stay out of version control.
ml/classification/**/__pycache__/
ml/trained_models/*.joblib
ml/trained_models/*.pkl
ml/classification/artifacts/*.tmp
!backend/app/classification/artifacts/*.joblib

# =============================================================================
# Temporary / scratch files
# =============================================================================
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~
*.log
logs/
tmp/
temp/
scratch/

# Project-local PostgreSQL cluster created by scripts/setup_database.py
# (contains a database cluster and its generated credentials — never commit)
.pgdata/
pgdata/

# Local audit/build scratch that must never be treated as a deliverable
/dump.rdb
*.sql.gz
.pgpass

# =============================================================================
# OS / editor
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.iml

# =============================================================================
# Certificates and keystores
# =============================================================================
# A certificate is not a secret in itself, but the private half and the bundles
# it travels with usually are, and a .crt committed once is hard to withdraw.
*.crt
*.cer
*.der
*.jks
*.keystore
*.truststore

# =============================================================================
# Database exports
# =============================================================================
# Plain exports can carry real farm, user or credential rows. Schema migrations
# are not exports: they are source, and the negations below keep them tracked.
*.sql
*.dump
*.sqlite
*.sqlite3
!backend/migrations/*.sql
!backend/migrations/**/*.sql

# =============================================================================
# Local artefacts that are not part of the source tree
# =============================================================================
# Screenshots are review evidence, regenerated by backend/scripts/*_screenshots.py
# and presentation_check.py; they are kept on disk and out of version control.
screenshots/
media-output/
dashboard-backend-status.png

# =============================================================================
# Local-only evidence and scratch scripts
# =============================================================================
# Raw provenance snapshots (fetched source pages, their hashes and a 6.9 MB PDF).
# They are the evidence behind the provenance manifest, kept on disk for audit,
# but they are third-party page captures rather than source: the manifest and the
# source register that cite them ARE tracked.
docs/phase3_1_audit_raw/

# One-off Phase 7 probe: prints rule traces for three queries. Not imported by
# the app, the tests or any script. Kept locally for reference only.
backend/probe_phase7.py
