# Backend environment configuration — EXAMPLE ONLY. Copy to backend/.env and fill in real values.
# Never commit backend/.env (real secrets) to Git. This file (.env.example) contains placeholders only.
#
# Phase 5 (DEC-012): the recommended way to obtain a working DATABASE_URL is
#     python scripts/setup_database.py --init-local-cluster
# which creates a project-local PostgreSQL cluster (.pgdata/, git-ignored,
# loopback-only, scram-sha-256) and writes the URL below into backend/.env.
# Never paste a real password into this example file.

# --- Database ---
# Default port for an existing system installation:
# DATABASE_URL=postgresql://pesticide_app:CHANGE_ME_PASSWORD@localhost:5432/pesticide_advisory
# Default port for the project-local cluster created by scripts/setup_database.py:
DATABASE_URL=postgresql://pesticide_app:CHANGE_ME_PASSWORD@127.0.0.1:55432/pesticide_advisory

# TLS for a managed database (Neon, Render, Supabase). Leave blank for the local
# cluster; set to `require` in the cloud. `verify-full` additionally checks the
# server certificate against the CA (needs the provider's CA bundle).
# DB_SSLMODE=require

# --- Knowledge-base backend (Module C) ---
# json     — version-controlled JSON files (default; no database required)
# postgres — PostgreSQL only; fails loudly if the database is unreachable
# auto     — PostgreSQL when reachable, otherwise JSON (the fallback is reported
#            by GET /knowledge-base/status, never silently hidden)
KB_REPOSITORY=json

# --- Vector storage (Module D) ---
# postgres (default) | memory (in-process, tests/diagnostics only)
VECTOR_STORE=postgres
# hashing (default, offline, deterministic, lexical) | sentence-transformer (optional extra, downloads weights)
EMBEDDING_PROVIDER=hashing
# auto (default) | array | pgvector
# Migration 0003 records what the database can do. `array` pins the exact-scan
# path that the test suite covers; set this in the cloud so a provider that
# ships pgvector does not silently switch production onto an untested branch.
# VECTOR_STORAGE_MODE=array

# --- LLM Provider (Module F — provider-agnostic interface, see DEC-004) ---
# Supported values: "ollama" (default/local) | "cloud" (future, not yet implemented)
# The current answer pipeline is extractive and calls no LLM; leaving this
# unset/unavailable is a supported state, not a fault.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Reserved for future cloud provider — leave blank for the pilot; never commit a real key here.
CLOUD_LLM_API_KEY=

# --- Application ---
# development | production. In production the app warns if CORS is still
# loopback-only, because a deployed frontend would then be blocked.
APP_ENV=development
LOG_LEVEL=INFO

# --- CORS (Phase 9) ---
# Comma-separated exact origins. Defaults to the two Vite dev-server forms.
# Set this to the deployed frontend origin. "*" is refused at startup.
# CORS_ORIGINS=https://your-frontend.vercel.app

# --- Supported languages (DEC-003: English + Hindi pilot, extensible) ---
SUPPORTED_LANGUAGES=en,hi
